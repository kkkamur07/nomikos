# Production environment (platform API on Vercel + Supabase)
# Copy values into the Vercel project environment settings. Never commit secrets.

ENVIRONMENT=production

# --- Supabase Postgres (see docs/supabase.md) ---
# Set these only in the deployment provider's secret store. The API uses the
# nomikos_api credential; the persistent worker has its own template and
# credential. Migration URLs never belong in the serverless API environment.
DATABASE_URL=
SYNC_DATABASE_URL=

# --- Supabase Storage ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=document-media
MEDIA_WEBP_LOSSLESS=true

# --- Auth ---
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SESSION_ROTATION_RATE_LIMIT_REQUESTS=120

# --- Browser origins (comma-separated) ---
# The app origin only. The marketing apex (https://nomikos.app) must not be
# listed: CORS runs with allow_credentials=True, so any origin here can drive
# authenticated cross-origin calls with the caller's cookies.
CORS_ORIGINS=https://app.nomikos.app

# --- Vercel / reverse proxy ---
# Set both only when the request reaches this process through a fixed,
# allowlisted proxy source range. Never use `*`.
#
# While BEHIND_PROXY=false, every request's observed address is the edge's, so
# any control keyed on the client IP is a single platform-wide counter. That is
# why the device layer has no IP-scoped list, no IP-scoped cap, and no
# same-network signal, and why AUTH_RATE_LIMIT_REQUESTS is a global budget for
# the auth routes rather than a per-caller one.
BEHIND_PROXY=false
FORWARDED_ALLOW_IPS=

# Declares that the peer address does NOT identify one client, which is the
# reality above. IP-keyed throttles are then skipped rather than collapsed into
# one global bucket that would 429 real users on each other's traffic; the auth
# routes fall back to a per-account budget instead, which does not depend on the
# network path. Read docs/security/rate-limiting.md before changing this.
TRUST_PEER_IP=false

# --- Helper device pairing ---
# Off until the /pair consent page exists. Turning it on requires
# DEVICE_TOKEN_HMAC_SECRET below; the API refuses to start without it.
DEVICE_PAIRING_ENABLED=false
# Keys every device token. MUST be set and MUST differ from JWT_SECRET: they are
# rotated on different schedules and for different reasons. Rotating JWT_SECRET
# logs browsers out, which a researcher recovers from by logging in again;
# rotating this unpairs every UI-less laptop, which they cannot.
DEVICE_TOKEN_HMAC_SECRET=
# A device token lives 180 days on a researcher's disk. Consent links are minutes.
DEVICE_TOKEN_TTL_DAYS=180
DEVICE_PAIRING_TTL_SECONDS=300
DEVICE_PAIRING_MAX_LIFETIME_SECONDS=900

# --- The claim endpoint (ADR 0003) ---
# The hosted worker's credential. It claims `cloud` work from the same endpoint a
# laptop claims `local` work from, and it is deliberately NOT a device token: a
# device token is bounded by one helper_devices.user_id, and cloud work is not
# bounded by any account. Treat it like JWT_SECRET, not like a device token.
# Leave empty until a hosted worker exists: unset means none can claim.
INFERENCE_WORKER_SERVICE_TOKEN=
# How long a claimed page stays with its agent. No heartbeat endpoint exists: the
# lease covers seconds-to-minutes work with margin, and abandonment is caught by
# the existing stale sweep rather than by a second liveness mechanism.
DEVICE_LEASE_SECONDS=600
# Long-poll ceiling. Serverless request duration is the real constraint here, so
# lower it before raising it. Hosted workers should short-poll (wait_seconds=0).
DEVICE_CLAIM_MAX_WAIT_SECONDS=25

# --- The agent version floor (ADR 0002) ---
# The kill switch for a known-bad agent. Below this, a claim is refused with 426
# and the agent is told to upgrade; a claim that states no version, or one that
# cannot be parsed, is refused too rather than assumed current.
#
# It lives here rather than being read from PyPI precisely so it can be turned
# without a release: raising it stops a bad build from taking work on the next
# poll, with nothing to install and nobody to wait for.
#
# Versions are compared numerically, so 0.10.0 is above a 0.9.0 floor.
INFERENCE_AGENT_MIN_VERSION=0.1.0
# Newest published agent. An agent at or above the floor but below this is served
# normally and told it is outdated: a notice, not a refusal, because most
# upgrades are not urgent. Leave unset to default to the floor, which is what
# keeps raising the floor a one-variable change.
# INFERENCE_AGENT_LATEST_VERSION=
# Distribution the refusal names. Only change this if the package is renamed.
# INFERENCE_AGENT_PACKAGE=nomikos-inference

# --- Serverless API: no in-process background workers ---
JOB_WORKER_ENABLED=false
JOB_SSE_NOTIFICATIONS_ENABLED=false

# --- Local OCR is the default ---
# The browser calls the loopback-only helper at http://127.0.0.1:8001 and the
# platform persists authenticated results. No inference service secret is needed.
CLOUD_INFERENCE_ENABLED=false

# --- Optional cloud inference ---
# A hosted worker claims jobs from this API the same way a paired laptop does
# (ADR 0003), so there is no inference service URL to point at. The API only
# needs the secret that authenticates the callback it receives.
# CLOUD_INFERENCE_ENABLED=true
# INFERENCE_WEBHOOK_SECRET=

# --- Safety ---
ENABLE_TEST_JOB_ROUTES=false
